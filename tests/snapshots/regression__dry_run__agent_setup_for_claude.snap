expression: "both(&sandbox, &workspace, &[])"
---
$ casulo run --dry-run
exit code: 0
--- stdout
casulo-test-missing-runtime run --rm --interactive --cap-drop=ALL --security-opt=no-new-privileges --pids-limit=1024 --read-only --pull=never --tmpfs=/tmp:rw,exec,nosuid,nodev,size=1g,mode=1777 --tmpfs=/home/casulo:rw,exec,nosuid,nodev,size=1g,uid=[UID],gid=[GID],mode=0700 --mount=type=bind,source=[HOME]/projects/demo/workspace,target=/workspace --mount=type=bind,source=[HOME]/projects/demo/config/claude,target=/home/casulo/.claude --mount=type=bind,source=[HOME]/agent/AGENTS.md,target=/home/casulo/.claude/CLAUDE.md,readonly --mount=type=bind,source=[HOME]/agent/skills,target=/home/casulo/.claude/skills,readonly --mount=type=bind,source=[HOME]/projects/demo/generated/claude/agents,target=/home/casulo/.claude/agents,readonly --mount=type=bind,source=[HOME]/projects/demo/generated/claude/mcp.json,target=/home/casulo/.casulo/mcp.json,readonly --workdir=/workspace --user=[UID]:[GID] --env=HOME=/home/casulo --env=CLAUDE_CONFIG_DIR=/home/casulo/.claude --env=ANTHROPIC_API_KEY --env=CLAUDE_CODE_OAUTH_TOKEN --env=CONTEXT7_TOKEN --env=GITHUB_TOKEN casulo/demo:claude claude --model opus --effort high --mcp-config /home/casulo/.casulo/mcp.json
