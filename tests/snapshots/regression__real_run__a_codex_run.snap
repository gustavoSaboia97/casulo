# Generated by casulo on every run. Read-only in the container.
[credential "https://example.com"]
	helper = "!f() { test $1 = get && echo username=x-access-token && echo password=$CASULO_GIT_TOKEN; }; f"
[url "https://example.com/"]
	insteadOf = git@example.com:
	insteadOf = ssh://git@example.com/
[core]
	hooksPath = /etc/casulo/hooks

