---
source: src/services/build.rs
expression: "dockerfile(&built_in(\"claude\"))"
---
# Generated by casulo for the "claude" harness. `casulo build` rewrites this file.
FROM node:24-trixie-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

# The agent runs as this unprivileged user, never as root.
RUN userdel --remove node \
    && useradd --create-home --home-dir /home/casulo --uid 1000 --shell /bin/bash casulo

# The workspace belongs to the host user, so git must be told to trust it.
RUN git config --system safe.directory /workspace

# Push settings. casulo run mounts this file only when push is enabled;
# git ignores a missing include, so pushing is off otherwise.
RUN git config --system include.path /etc/casulo/push.gitconfig

# Install the agent.
RUN npm install -g @anthropic-ai/claude-code

USER casulo
WORKDIR /workspace
