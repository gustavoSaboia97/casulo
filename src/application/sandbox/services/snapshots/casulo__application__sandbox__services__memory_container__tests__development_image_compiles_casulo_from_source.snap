---
source: src/services/memory.rs
expression: dockerfile(&source)
---
# syntax=docker/dockerfile:1
# Generated by casulo for the memory server. `casulo build` rewrites this file.
FROM debian:bookworm-slim AS base
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --home-dir /home/casulo --uid 1000 --shell /bin/bash casulo

FROM rust:1-slim-bookworm AS builder
WORKDIR /src
COPY . .
RUN cargo build --release --locked --bin casulo

FROM base
COPY --from=builder /src/target/release/casulo /usr/local/bin/casulo

USER casulo
